# Filled automatically by: python -m kcex.cli login  (file is chmod 600 by the CLI)
KCEX_TOKEN=
KCEX_TOKEN_AT=

# Optional: the login command can type these into the browser.
# You still complete captcha + Google Authenticator yourself.
KCEX_EMAIL=
KCEX_PASSWORD=

# Optional device fingerprint header used by the site (user-device)
KCEX_USER_DEVICE=

KCEX_BASE_URL=https://www.kcex.com
KCEX_LANGUAGE=en-US
KCEX_PLATFORM=WEB
# The WAF returns 406 for curl's default User-Agent; leave empty to use a Chrome UA.
KCEX_USER_AGENT=

# paper = ledger local no preço real da KCEX. live = ordem de verdade (precisa KCEX_TOKEN).
MODE=paper
SYMBOL=BTC_USDT
# Código default é 15 se esta linha sumir. Ops usa 5.
CYCLE_MINUTES=5
# P2 opt-in: minutos apos um SELL com PREJUIZO; 0 desliga. Bloqueia BUY, nunca SELL.
# Uma saida no lucro NAO arma o cooldown -- reentrar na mesma direcao enquanto o
# movimento segue e cavalgar, nao vinganca, e bloquear ali so cancela lucro.
# Reinicio nao zera: usa o ultimo SELL perdedor do ledger. 30 min e experimento.
COOLDOWN_MINUTES=0
# P4 opt-in: diario point-in-time; ate 5 licoes, reflexao diferida apos executar.
# Usa MESMO budget/modelo; reserva estimada para decisao seguinte, nao teto garantido.
JOURNAL_ENABLED=0
# Caixa virtual inicial do paper (depois o ledger manda).
PAPER_STARTING_USDT=450
PAPER_SLIPPAGE_BPS=5
WAKE_MOVE_PCT=0.004
MAX_ORDER_USDT=20
MAX_PORTFOLIO_PCT=0.05
# Realizado + não realizado do dia (UTC). Bloqueia compras, nunca vendas.
MAX_DAY_LOSS_USDT=20
ATR_PERIOD=14
ATR_MULT=2.0
MIN_STOP_PCT=0.004
MAX_STOP_PCT=0.04
# P1 opt-in: 0 desliga; alvo LOCAL, nao e uma segunda ordem residente.
TP_ATR_MULT=0
MIN_TP_PCT=0.006
MAX_TP_PCT=0.06
TIME_LIMIT_MINUTES=0
# BUY só com confidence >= isto (0 = desligado). SELL nunca é bloqueado por isto.
MIN_CONFIDENCE=0

# LLM: orçamento cobrado pelo custo real (usage.cost) da resposta; fallback quando não vier.
LLM_DAILY_BUDGET_USD=2
LLM_FALLBACK_COST_USD=0.02
LLM_MAX_TOKENS=200
LLM_JSON_MODE=0
OPENROUTER_API_KEY=
LLM_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Preço: socket público (verificado); REST só como fallback.
WS_ENABLED=1
# Vazio = default capturado wss://wbs.kcex.com/ws?platform=web
# Use - para forçar cotações só por REST.
KCEX_WS_URL=
POLL_SECONDS=5
STALE_MS=30000

# Chart local (--chart). Só loopback.
CHART_HOST=127.0.0.1
CHART_PORT=8765

# Live: confirmação de fill por saldo.
FILL_CONFIRM_TRIES=6
FILL_CONFIRM_WAIT_S=0.5

LOG_LEVEL=INFO

# --- Futures paper (python -m fut run). Paper only; no KCEX login needed. ---
FUT_LEVERAGE=1
FUT_MARGIN_USDT=20
FUT_MAX_BALANCE_PCT=0.05
FUT_MAX_DAY_LOSS_USDT=20
FUT_PAPER_STARTING_USDT=450
FUT_SLIPPAGE_BPS=2
FUT_ATR_PERIOD=14
FUT_ATR_MULT=2
FUT_MIN_STOP_PCT=0.001
FUT_MAX_STOP_PCT=0.01
FUT_LIQ_STOP_RATIO=0.5
FUT_MAX_HOLD_SECONDS=300
# Ignore Jev exit/reversal wakes for this many seconds after entry (0 = off). Stop/liq/max hold still apply.
FUT_MIN_HOLD_SECONDS=0
# Refuse entries when the spread is at least this many basis points (0 = off).
FUT_MAX_SPREAD_BPS=0
# Refuse entries when expected move is below this multiple of round-trip cost (0 = off).
FUT_MIN_MOVE_MULT=0
# Refuse new entries after this many opens in the last hour (0 = off).
FUT_MAX_ENTRIES_PER_HOUR=0
FUT_MIN_CONFIDENCE=0
# Jev (TypeSafe). Empty key or FUT_JEV_MODEL=mock uses the stand-in (never counts for edge).
TYPESAFE_API_KEY=
FUT_JEV_MODEL=jev-latest
FUT_JEV_EVERY_SECONDS=2
FUT_JEV_TIMEOUT_SECONDS=2
FUT_JEV_USD_PER_MTOK=0.042
# Optional observational A/B call with semantic labels; doubles Jev cost and never drives trading.
FUT_JEV_AB=0
FUT_WAKE_THRESHOLD=0.6
# Require this many consecutive same-side Jev evaluations before an entry wake (1 = current behavior).
FUT_WAKE_STREAK=1
# Allowed entry regimes, comma-separated trend/range/volatile; empty = any.
FUT_WAKE_REGIMES=
FUT_MOVE_COST_BPS=3
# LLM call rules (model/key/budget come from LLM_MODEL, OPENROUTER_API_KEY, LLM_DAILY_BUDGET_USD).
FUT_LLM_COOLDOWN_SECONDS=10
FUT_LLM_TIMEOUT_SECONDS=8
FUT_STALE_PRICE_BPS=5
FUT_LLM_REASONING=0
# Market freshness. Empty = wss://www.kcex.com/fapi/edge; - = REST only (entries stay blocked).
FUT_WS_URL=
FUT_STALE_MARKET_SECONDS=5
FUT_UNMONITORED_SECONDS=60
FUT_SHADOW_SEED=7

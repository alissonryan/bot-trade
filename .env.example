# Filled automatically by: python -m kcex.cli login
KCEX_TOKEN=

# Optional: the login command can type these into the browser.
# You still complete captcha + Google Authenticator yourself.
KCEX_EMAIL=
KCEX_PASSWORD=

# Optional device fingerprint header used by the site (user-device)
KCEX_USER_DEVICE=

KCEX_BASE_URL=https://www.kcex.com
KCEX_LANGUAGE=en-US
KCEX_PLATFORM=WEB
